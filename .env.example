# Copy to .env and fill in. Every var the stack will eventually need is listed
# here, even ones not wired yet, so it stays a living checklist (CLAUDE.md).

# --- MongoDB (backend-services only — no other service should ever read this) ---
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=servicesphere
MONGO_ROOT_USER=
MONGO_ROOT_PASSWORD=

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Qdrant ---
QDRANT_URL=http://localhost:6333

# --- MinIO (S3-compatible object storage) ---
MINIO_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=servicesphere
MINIO_ROOT_PASSWORD=servicesphere-dev

# --- Service addresses (host:port each Connect server listens on) ---
BACKEND_SERVICES_ADDR=:8081
BACKEND_SERVICES_URL=http://localhost:8081
AI_SERVICES_ADDR=:8082
AI_SERVICES_URL=http://localhost:8082
ANALYSIS_SERVICES_ADDR=:8083
ANALYSIS_SERVICES_URL=http://localhost:8083

# --- Auth ---
JWT_SECRET=change-me-in-every-environment
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=7

# --- LLM providers ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OPENAI_API_KEY=
OPENAI_BASE_URL=
LLM_PROVIDER=ollama

# --- Observability ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3001
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# --- Multi-tenancy (dev default while domain packs are still single-tenant) ---
DEFAULT_TENANT_ID=it-services
